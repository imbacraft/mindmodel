{
  "id": "spring-security",
  "version": 1,
  "when": {
    "deps": [
      "org.springframework.boot:spring-boot-starter-security",
      "org.springframework.security:spring-security-config",
      "org.springframework.security:spring-security-web"
    ],
    "imports": [
      "org.springframework.security."
    ]
  },
  "annotations": [
    {
      "fqns": [
        "org.springframework.security.config.annotation.web.configuration.EnableWebSecurity"
      ],
      "means": "security-config",
      "on": [
        "type"
      ]
    },
    {
      "fqns": [
        "org.springframework.security.config.annotation.method.configuration.EnableMethodSecurity",
        "org.springframework.security.config.annotation.method.configuration.EnableGlobalMethodSecurity"
      ],
      "means": "method-security",
      "on": [
        "type"
      ]
    },
    {
      "fqns": [
        "org.springframework.security.access.prepost.PreAuthorize"
      ],
      "means": "method-security",
      "on": [
        "method"
      ]
    },
    {
      "fqns": [
        "org.springframework.security.access.prepost.PostAuthorize"
      ],
      "means": "method-security",
      "on": [
        "method"
      ]
    },
    {
      "fqns": [
        "org.springframework.security.access.annotation.Secured"
      ],
      "means": "method-security",
      "on": [
        "method"
      ]
    },
    {
      "fqns": [
        "org.springframework.security.test.context.support.WithMockUser"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "org.springframework.security.test.context.support.WithAnonymousUser"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    }
  ],
  "maps": {
    "access-calls": {
      "permitAll": "anonymous",
      "authenticated": "authenticated",
      "hasRole": "role:{literal}",
      "hasAnyRole": "role:{literal}",
      "hasAuthority": "authority:{literal}",
      "hasAnyAuthority": "authority:{literal}",
      "denyAll": "blocked"
    },
    "security-types": {
      "context-holder": "org.springframework.security.core.context.SecurityContextHolder"
    }
  },
  "lists": {
    "verifier-types": [
      "org.springframework.security.authentication.AuthenticationManager",
      "org.springframework.security.authentication.ProviderManager",
      "org.springframework.security.oauth2.jwt.JwtDecoder",
      "io.jsonwebtoken.JwtParser",
      "java.security.MessageDigest",
      "javax.crypto.Mac",
      "java.security.Signature",
      "org.springframework.security.crypto.password.PasswordEncoder",
      "org.springframework.security.oauth2.server.resource.web.BearerTokenResolver"
    ],
    "caller-types": [
      "Authentication",
      "Principal"
    ]
  },
  "patterns": {
    "http-method-enum": "HttpMethod\\.(\\w+)"
  }
}
