{
  "id": "messaging",
  "version": 1,
  "when": {
    "deps": [
      "org.springframework.kafka:spring-kafka",
      "org.springframework.amqp:spring-rabbit",
      "org.springframework:spring-jms",
      "jakarta.jms:jakarta.jms-api",
      "jakarta.platform:jakarta.jakartaee-api",
      "org.springframework.boot:spring-boot-starter-amqp",
      "org.springframework.boot:spring-boot-starter-artemis",
      "com.amazonaws:aws-java-sdk-sqs"
    ],
    "imports": [
      "org.springframework.kafka.",
      "org.springframework.amqp.",
      "org.springframework.jms.",
      "jakarta.jms."
    ]
  },
  "annotations": [],
  "calls": [
    {
      "type": "org.springframework.kafka.core.KafkaTemplate",
      "means": "outside-call",
      "kind": "Kafka"
    },
    {
      "type": "org.springframework.amqp.rabbit.core.RabbitTemplate",
      "means": "outside-call",
      "kind": "RabbitMQ"
    },
    {
      "type": "org.springframework.jms.core.JmsTemplate",
      "means": "outside-call",
      "kind": "JMS"
    },
    {
      "type": "jakarta.jms.MessageProducer",
      "means": "outside-call",
      "kind": "JMS"
    },
    {
      "type": "com.amazonaws.services.sqs.AmazonSQS",
      "means": "outside-call",
      "kind": "SQS"
    },
    {
      "type": "jakarta.jms.JMSProducer",
      "methods": [
        "send",
        "sendAsync"
      ],
      "means": "outside-call",
      "kind": "JMS"
    },
    {
      "type": "javax.jms.JMSProducer",
      "methods": [
        "send"
      ],
      "means": "outside-call",
      "kind": "JMS"
    }
  ],
  "signatures": [
    {
      "type": "jakarta.jms.JMSContext",
      "methods": {
        "createProducer": "jakarta.jms.JMSProducer",
        "createConsumer": "jakarta.jms.JMSConsumer",
        "createContext": "jakarta.jms.JMSContext",
        "createDurableConsumer": "jakarta.jms.JMSConsumer"
      }
    },
    {
      "type": "jakarta.jms.JMSProducer",
      "methods": {
        "send": "jakarta.jms.JMSProducer",
        "sendAsync": "jakarta.jms.JMSProducer",
        "setPriority": "jakarta.jms.JMSProducer",
        "setDisableMessageID": "jakarta.jms.JMSProducer",
        "setDisableMessageTimestamp": "jakarta.jms.JMSProducer",
        "setTimeToLive": "jakarta.jms.JMSProducer",
        "setDeliveryMode": "jakarta.jms.JMSProducer",
        "setDeliveryDelay": "jakarta.jms.JMSProducer",
        "setCorrelationID": "jakarta.jms.JMSProducer",
        "setProperty": "jakarta.jms.JMSProducer",
        "setJMSCorrelationID": "jakarta.jms.JMSProducer"
      }
    },
    {
      "type": "jakarta.jms.ConnectionFactory",
      "methods": {
        "createContext": "jakarta.jms.JMSContext"
      }
    }
  ]
}
