{
  "id": "messaging",
  "version": 1,
  "when": {
    "deps": [
      "org.springframework.kafka:spring-kafka",
      "org.springframework.amqp:spring-rabbit",
      "org.springframework:spring-jms",
      "jakarta.jms:jakarta.jms-api",
      "jakarta.platform:jakarta.jakartaee-api",
      "org.springframework.boot:spring-boot-starter-amqp",
      "org.springframework.boot:spring-boot-starter-artemis",
      "com.amazonaws:aws-java-sdk-sqs"
    ],
    "imports": [
      "org.springframework.kafka.",
      "org.springframework.amqp.",
      "org.springframework.jms.",
      "jakarta.jms."
    ]
  },
  "annotations": [],
  "calls": [
    {
      "type": "org.springframework.kafka.core.KafkaTemplate",
      "means": "outside-call",
      "kind": "Kafka"
    },
    {
      "type": "org.springframework.amqp.rabbit.core.RabbitTemplate",
      "means": "outside-call",
      "kind": "RabbitMQ"
    },
    {
      "type": "org.springframework.jms.core.JmsTemplate",
      "means": "outside-call",
      "kind": "JMS"
    },
    {
      "type": "jakarta.jms.MessageProducer",
      "means": "outside-call",
      "kind": "JMS"
    },
    {
      "type": "com.amazonaws.services.sqs.AmazonSQS",
      "means": "outside-call",
      "kind": "SQS"
    },
    {
      "type": "jakarta.jms.JMSProducer",
      "methods": [
        "send",
        "sendAsync"
      ],
      "means": "outside-call",
      "kind": "JMS"
    },
    {
      "type": "javax.jms.JMSProducer",
      "methods": [
        "send"
      ],
      "means": "outside-call",
      "kind": "JMS"
    }
  ],
  "signatures": [
    {
      "type": "jakarta.jms.JMSContext",
      "methods": {
        "createProducer": "jakarta.jms.JMSProducer",
        "createConsumer": "jakarta.jms.JMSConsumer",
        "createContext": "jakarta.jms.JMSContext",
        "createDurableConsumer": "jakarta.jms.JMSConsumer"
      }
    },
    {
      "type": "jakarta.jms.JMSProducer",
      "methods": {
        "send": "jakarta.jms.JMSProducer",
        "sendAsync": "jakarta.jms.JMSProducer",
        "setPriority": "jakarta.jms.JMSProducer",
        "setDisableMessageID": "jakarta.jms.JMSProducer",
        "setDisableMessageTimestamp": "jakarta.jms.JMSProducer",
        "setTimeToLive": "jakarta.jms.JMSProducer",
        "setDeliveryMode": "jakarta.jms.JMSProducer",
        "setDeliveryDelay": "jakarta.jms.JMSProducer",
        "setCorrelationID": "jakarta.jms.JMSProducer",
        "setProperty": "jakarta.jms.JMSProducer",
        "setJMSCorrelationID": "jakarta.jms.JMSProducer"
      }
    },
    {
      "type": "jakarta.jms.ConnectionFactory",
      "methods": {
        "createContext": "jakarta.jms.JMSContext"
      }
    }
  ],
  "lists": {
    "message-driven-annotations": [
      "MessageDriven"
    ],
    "listener-types": [
      "MessageListener",
      "MessageDrivenBean"
    ],
    "sqs-listener-annotations": [
      "SqsListener"
    ],
    "consumer-poll-methods": [
      "poll",
      "nextDelivery",
      "receive",
      "receiveNoWait"
    ]
  },
  "patterns": {
    "messaging-receivers": "(MessageChannel|StreamBridge|MessageProducer|SubscribableChannel|DirectChannel|Source|Sink)$"
  },
  "tables": {
    "channel-rules": [
      {
        "kind": "kafka",
        "dir": "in",
        "annotation": "KafkaListener",
        "arg": "topics"
      },
      {
        "kind": "jms",
        "dir": "in",
        "annotation": "JmsListener",
        "arg": "destination"
      },
      {
        "kind": "rabbit",
        "dir": "in",
        "annotation": "RabbitListener",
        "arg": "queues"
      },
      {
        "kind": "sqs",
        "dir": "in",
        "annotation": "SqsListener",
        "arg": "queues"
      },
      {
        "kind": "stream",
        "dir": "in",
        "annotation": "StreamListener",
        "arg": "value"
      },
      {
        "kind": "kafka",
        "dir": "out",
        "recv": "KafkaTemplate",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "kafka",
        "dir": "out",
        "recv": "KafkaProducer",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "kafka",
        "dir": "out",
        "recv": "StreamBridge",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "jms",
        "dir": "out",
        "recv": "JmsTemplate",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "jms",
        "dir": "out",
        "recv": "JMSProducer",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "jms",
        "dir": "out",
        "recv": "JMSContext",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "jms",
        "dir": "out",
        "recv": "MessageProducer",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "rabbit",
        "dir": "out",
        "recv": "RabbitTemplate",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "sqs",
        "dir": "out",
        "recv": "SqsClient",
        "names": [
          "send",
          "convertAndSend",
          "publish",
          "sendAndReceive",
          "convertSendAndReceive",
          "syncSend"
        ]
      },
      {
        "kind": "kafka",
        "dir": "out",
        "name": "withChannel",
        "via": "eventuate"
      },
      {
        "kind": "kafka",
        "dir": "in",
        "name": "fromChannel",
        "via": "eventuate"
      },
      {
        "kind": "kafka",
        "dir": "in",
        "name": "forAggregateType",
        "via": "aggregate"
      },
      {
        "kind": "kafka",
        "dir": "in",
        "name": "andForAggregateType",
        "via": "aggregate"
      },
      {
        "kind": "kafka",
        "dir": "out",
        "recv": "Publisher",
        "names": [
          "publish"
        ],
        "publisher": true
      },
      {
        "kind": "kafka",
        "dir": "in",
        "recv": "StreamsBuilder",
        "name": "stream",
        "named": true
      },
      {
        "kind": "kafka",
        "dir": "out",
        "name": "to",
        "named": true
      },
      {
        "kind": "kafka",
        "dir": "in",
        "consumer": true,
        "recv": "KafkaConsumer",
        "names": [
          "subscribe",
          "basicConsume",
          "createConsumer"
        ]
      },
      {
        "kind": "rabbit",
        "dir": "in",
        "consumer": true,
        "recv": "Channel",
        "names": [
          "subscribe",
          "basicConsume",
          "createConsumer"
        ]
      },
      {
        "kind": "jms",
        "dir": "in",
        "consumer": true,
        "recv": "Session",
        "names": [
          "subscribe",
          "basicConsume",
          "createConsumer"
        ]
      },
      {
        "kind": "jms",
        "dir": "in",
        "consumer": true,
        "recv": "JMSContext",
        "names": [
          "subscribe",
          "basicConsume",
          "createConsumer"
        ]
      },
      {
        "kind": "jms",
        "dir": "in",
        "consumer": true,
        "recv": "MessageConsumer",
        "names": [
          "subscribe",
          "basicConsume",
          "createConsumer"
        ]
      }
    ]
  }
}
