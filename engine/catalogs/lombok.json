{
  "id": "lombok",
  "version": 1,
  "when": {
    "deps": [
      "org.projectlombok:lombok"
    ],
    "imports": [
      "lombok."
    ]
  },
  "annotations": [
    {
      "fqns": [
        "lombok.Data"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.Value"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.Getter"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.Setter"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.Builder"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.SuperBuilder"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.NoArgsConstructor"
      ],
