        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.AllArgsConstructor"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.RequiredArgsConstructor"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.EqualsAndHashCode"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
      ]
    },
    {
      "fqns": [
        "lombok.ToString"
      ],
      "means": "ignore",
      "on": [
        "type",
        "method",
        "field",
        "parameter"
