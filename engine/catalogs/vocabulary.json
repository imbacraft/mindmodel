    "servlet-attribute-holders": [
      "jakarta.servlet.ServletRequest",
      "jakarta.servlet.http.HttpServletRequest",
      "jakarta.servlet.http.HttpSession",
      "javax.servlet.ServletRequest",
      "javax.servlet.http.HttpServletRequest",
      "javax.servlet.http.HttpSession"
    ],
    "untyped-store-calls": [
      "setAttribute",
      "setAuthentication",
      "setContext"
    ],
    "async-annotations": [
      "Async",
      "Asynchronous"
    ],
    "interceptor-annotations": [
      "WebFilter",
      "Interceptor"
    ],
    "around-invoke-annotations": [
      "AroundInvoke"
    ],
    "interceptor-registration-calls": [
      "addInterceptor",
      "addPathPatterns",
      "excludePathPatterns"
    ],
    "request-scope-annotations": [
      "RequestScoped",
      "SessionScoped",
      "ConversationScoped",
      "ViewScoped",
      "Scope",
      "ControllerAdvice"
    ],
    "method-scope-annotations": [
      "Scope"
    ],
    "exception-handler-annotations": [
      "ExceptionHandler"
    ],
    "startup-annotations": [
      "Startup"
    ],
    "session-attribute-annotations": [
      "SessionAttributes"
    ],
    "session-attribute-calls": [
      "setAttribute",
      "getAttribute"
    ],
    "stomp-config-calls": [
      "registerStompEndpoints",
      "enableSimpleBroker"
    ]
  },
  "patterns": {
    "plumbing-calls": "^(?:(?:get|set|is|has|to|of|with|from)[A-Z_$]|name$|size$|isEmpty$|isBlank$|orElse$|ifPresent$|toString$|equals$|hashCode$|valueOf$|stream$|collect$|map$|filter$|forEach$|add$|put$|remove$|iterator$|next$|parse$|now$|split$|trim$|length$|charAt$|contains$|matches$|matcher$|test$|apply$|accept$|run$|execute$|warn$|info$|error$|debug$|trace$|lock$|unlock$|requireNonNull$|printStackTrace$|format$|append$|build$|call$)",
    "platform-types": "^(java|jakarta|javax)\\.",
    "scheduler-type": "(?:Scheduler|Timer|WheelTimer|Executor)$",
    "message-kind": "(?i)^(Kafka|Rabbit|RabbitMQ|JMS|SQS|PubSub|Messaging|MQ|AMQP)$",
    "tenancy-not-a-key": "(?i)^(id|version|isNew|new\\w*|(gmt|created|updated|modified|deleted|occurred|expires)_?\\w*|created_?at|updated_?at|created_?by|updated_?by|creator|modifier|lastModified\\w*|tenant\\w*Id)$",
    "status-type-name": "(?:Status|State)$",
    "status-field-name": "(?i)^(?:status|state)$",
    "frontend-build": "NpmTask|node-gradle|com\\.github\\.node|frontend-maven-plugin|npm\\s+run|yarnBuild",
    "frontend-served-hook": "(processResources|bootJar|generate-resources|prepare-package)[^\\n]*",
    "interceptor-supers": "(ContainerRequestFilter|ContainerResponseFilter|OncePerRequestFilter|HandlerInterceptor|Filter)$",
    "interceptor-registration-type": "FilterRegistrationBean",
    "thread-local-type": "ThreadLocal",
    "exception-mapper-supers": "ExceptionMapper$",
    "base-class-exclusions": "Repository$|Exception$|^Object$",
    "runner-supers": "(CommandLineRunner|ApplicationRunner)",
    "session-holder-type": "HttpSession$",
    "session-view-reads": "sessionScope\\.|session\\.getAttribute"
  },
  "maps": {
    "sdk-vendors": {
      "com.stripe": "Stripe",
      "com.google.api": "Google APIs",
      "com.google.cloud": "Google Cloud",
      "software.amazon": "AWS",
