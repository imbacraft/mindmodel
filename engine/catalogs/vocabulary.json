      "javax.ws.rs.client": "(HTTP client: JAX-RS)",
      "org.eclipse.microprofile.rest.client": "(HTTP client: MicroProfile)"
    }
  },
  "tables": {
    "local-servers": [
      {
        "pattern": "quarkus-maven-plugin",
        "goal": "quarkus:dev",
        "label": "Quarkus",
        "port": 8080
      },
      {
        "pattern": "liberty-maven-plugin",
        "goal": "liberty:run",
        "label": "Open Liberty",
        "port": 9080
      },
      {
        "pattern": "wildfly(-jar)?-maven-plugin",
        "goal": "wildfly:run",
        "label": "WildFly",
        "port": 8080
      },
      {
        "pattern": "payara-micro-maven-plugin",
        "goal": "payara-micro:start",
        "label": "Payara Micro",
        "port": 8080
      },
      {
        "pattern": "tomee-maven-plugin",
        "goal": "tomee:run",
        "label": "TomEE",
        "port": 8080
      },
      {
        "pattern": "cargo-maven\\d?-plugin",
        "goal": "cargo:run",
        "label": null,
        "port": 8080
      }
    ]
  }
}
